class Solution {
  public:
    vector<int> maxOfSubarrays(vector<int>& arr, int k) {
        vector<int>res;
       int i=0,j=0;
      priority_queue<pair<int,int>>pq;
         while (j < arr.size()) {
           pq.push({arr[j],j});
            if (j - i + 1 < k) {
                j++;
            }
            else if (j - i + 1 == k) {
                while(!pq.empty()&&pq.top().second<i)
                {
                    pq.pop();
                }
                res.push_back(pq.top().first);
                i++;
                j++;
            }
        }
        return res;
    }
};